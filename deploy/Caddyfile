# Caddy in front of the Kozmosz server. Installed to /etc/caddy/Caddyfile by deploy/install.sh.
# Caddy only adds TLS: the app already compresses its responses and sets its cache headers.
# Check after a change: sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy

# The real address. Caddy gets and renews the Let's Encrypt certificate by itself, as soon as
# kozmosz.bme.hu points to this machine (until then it keeps retrying in the background).
kozmosz.bme.hu {
	reverse_proxy 127.0.0.1:3000
}

# Until the DNS switch: the site over plain HTTP at the machine's own address (http://<IP>/).
# Delete this block after the switch if the site should only be reachable over HTTPS.
:80 {
	reverse_proxy 127.0.0.1:3000
}
