# Kozmosz server settings. Installed to /etc/kozmosz/kozmosz.env (install.sh never overwrites an
# existing copy) and read by kozmosz.service. After a change: sudo systemctl restart kozmosz

# Leptos: production mode, files next to the binary in /opt/kozmosz.
LEPTOS_OUTPUT_NAME=kozmosz
LEPTOS_SITE_ROOT=site
LEPTOS_SITE_PKG_DIR=pkg
LEPTOS_ENV=PROD
LEPTOS_HASH_FILES=true
# Only reachable from this machine: Caddy is in front of it.
LEPTOS_SITE_ADDR=127.0.0.1:3000

# Drive galleries (README, "Drive-galériák"). The cache survives restarts and updates.
KOZMOSZ_DRIVE_DIR=/var/lib/kozmosz/drive-cache
# Public folders through the Drive API instead of their embed page:
#KOZMOSZ_DRIVE_API_KEY=
# Private folders through a service account: see deploy/README.md ("Drive service account").
